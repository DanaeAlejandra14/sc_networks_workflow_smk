# cell typist , anotacion de las celulas no asignadas con un modelo de referencia, usando celltypist, un modelo de anotacion de celulas basado en aprendizaje
rule run_celltypist:
    input:
        h5ad="results/unassigned_export/unassigned.h5ad",
    output:
        predictions="results/unassigned_export/unassigned_celltypist_predictions.csv",
    params:
        model=config["annotation"]["celltypist_model"],
        majority_voting=config["annotation"]["majority_voting"],
        min_prob=config["annotation"]["min_prob"],
    log:
        "logs/run_celltypist/run_celltypist.log",
    conda:
        "envs/celltypist_env.yaml"
    shell: #identar bien y ponerle comillas y /
            "$CONDA_PREFIX/bin/python workflow/scripts/5.3_run_celltypist.py "
            "--h5ad {input.h5ad} "
            "--model {params.model} "
            "--majority-voting {params.majority_voting} "
            "--min-prob {params.min_prob} "
            "--out {output.predictions} "
            "> {log} 2>&1"
    


rule merge_celltypist_back:
    input:
        annotated_dir="results/annotated_reference/{library_batch}",
        predictions="results/unassigned_export/unassigned_celltypist_predictions.csv",
